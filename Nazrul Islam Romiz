          <label for="size">Size / Level</label>
          <input
            type="text"
            id="size"
            placeholder="যেমন: 16-20"
            autocomplete="off"
          >
        </div>

        <div>
          <label for="quantity">Quantity</label>
          <input
            type="number"
            id="quantity"
            value="10"
            min="1"
            max="500"
          >
        </div>

      </div>

      <div class="buttons">
        <button class="generate" onclick="generateLabels()">
          ✨ Generate
        </button>

        <button class="print" onclick="window.print()">
          🖨️ Print
        </button>

        <button class="clear" onclick="clearLabels()">
          🗑️ Clear
        </button>
      </div>
    </section>


    <section class="card">
