    const items = document.querySelectorAll(".item");
    const preview = document.getElementById("preview");

    preview.innerHTML = "";

    let hasData = false;

    items.forEach(item => {
      const inputs = item.querySelectorAll("input");

      const size = inputs[0].value.trim();
      const quantity = parseInt(inputs[1].value) || 0;

      if (size && quantity > 0) {
        hasData = true;

        for (let i = 0; i < quantity; i++) {
          const label = document.createElement("div");
          label.className = "label-preview";
          label.textContent = size;

          preview.appendChild(label);
        }
      }
    });

    if (!hasData) {
      preview.innerHTML =
        '<span style="color:#888;">আপনার Size এখানে দেখা যাবে...</span>';
    }
  }

  function printLabels() {
    const items = document.querySelectorAll(".item");
    const printArea = document.getElementById("printArea");

    printArea.innerHTML = "";

    let total = 0;

    items.forEach(item => {
      const inputs = item.querySelectorAll("input");

      const size = inputs[0].value.trim();
      const quantity = parseInt(inputs[1].value) || 0;

      if (size && quantity > 0) {
        for (let i = 0; i < quantity; i++) {

          const label = document.createElement("div");
          label.className = "print-label";
          label.textContent = size;

          printArea.appendChild(label);

          total++;
        }
      }
    });

    if (total === 0) {
      alert("দয়া করে অন্তত একটি Size এবং Quantity দিন।");
      return;
    }

    window.print();
  }

  // প্রথম Size row
  addItem("S", 1);
</script>

</body>
</html>
