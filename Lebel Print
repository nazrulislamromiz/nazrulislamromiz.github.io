      if (quantity > 500) {
        alert("সর্বোচ্চ 500টি Label তৈরি করা যাবে।");
        return;
      }

      labels.innerHTML = "";

      for (let i = 0; i < quantity; i++) {

        const box = document.createElement("div");

        box.className = "label-box";

        box.textContent = size;

        labels.appendChild(box);
